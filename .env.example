ADMIN_KEY=change-me-now
PORT=7860
WORKERS=1
LOG_LEVEL=INFO
MAX_INFLIGHT=1
MAX_RETRIES=3
ACCOUNT_MIN_INTERVAL_MS=1200
REQUEST_JITTER_MIN_MS=120
REQUEST_JITTER_MAX_MS=360
RATE_LIMIT_BASE_COOLDOWN=600
RATE_LIMIT_MAX_COOLDOWN=3600
# WAF 命中后固定账号原地重试前的额外冷却（秒），叠加在指数退避之上
WAF_RETRY_EXTRA_COOLDOWN_SECONDS=30
# 重试退避按 base * 2^attempt 增长并封顶（秒）。固定 2~5s 的退避在风控看来
# 就是"被拦后立刻接着打"，故改为指数增长
WAF_RETRY_BACKOFF_BASE_SECONDS=5
WAF_RETRY_BACKOFF_MAX_SECONDS=60
# 预热强度：单账号单模型保留份数 / 存活时长 / 并发 / 补给轮询间隔。
# 预热本身就是上游请求，强度过高会形成明显的自动化脉冲
CHAT_ID_PREWARM_TARGET_PER_ACCOUNT=2
CHAT_ID_PREWARM_TTL_SECONDS=900
CHAT_ID_PREWARM_MAX_CONCURRENCY=4
CHAT_ID_PREWARM_REFILL_INTERVAL_SECONDS=300
# Qwen 网页协议版本。2026-10-30 二次实测：0.3.27 + 短效 access_token 可正常出流，
# 0.2.91 反而返回 Bad_Request。注意版本号必须和 token 类型一起实测 —— 此前用长期
# token 测 0.3.27 得到 401，就误判成"服务端只认 0.2.91"，其实是被 token 类型带偏了。
QWEN_WEB_VERSION=0.3.27
# 短效 access_token 只能由真浏览器签发（HTTP signin 只发长期 token，auth 域又被
# AWSC 挑战）。开启后由 headless chromium 登录签 token，业务请求仍走 httpx/curl。
QWEN_BROWSER_TOKEN_ENABLED=true
# 后台续期轮询间隔（秒）。access_token 只有 900s，提前 120s 续。
QWEN_TOKEN_REFRESH_INTERVAL_SECONDS=60
# bx-v 由端侧 SDK 注入（浏览器抓包可见 bx-v: 2.5.37）。保留仅为兼容。
QWEN_BX_VERSION=2.5.37
# qwen-max / qwen-plus 的上游目标；升级模型时只改这里
QWEN_MAX_MODEL=qwen3.8-max
QWEN_PLUS_MODEL=qwen3.7-plus
# 未设置时预热自动跟随上面两个别名；显式设为空可关闭默认模型预热
# CHAT_ID_PREWARM_MODELS=
# 上游出站代理（留空=直连）。对接 MicroWARP（Cloudflare WARP SOCKS5）示例：
# UPSTREAM_PROXY=socks5h://microwarp:1080
# 带认证：socks5h://user:pass@microwarp:1080
# 会注入 curl_cffi new_session（chat/login/预热/WAF 首页 GET）和 httpx 重试路径。
UPSTREAM_PROXY=
# 默认 false=主流式走 curl_cffi（TLS 指纹 + 代理）。true=回退 httpx Go-like（易被 WAF 打）。
# QWEN_CHAT_TRANSPORT_GO_LIKE_HTTP=false
ACCOUNTS_FILE=/workspace/data/accounts.json
USERS_FILE=/workspace/data/users.json
CAPTURES_FILE=/workspace/data/captures.json
CONTEXT_GENERATED_DIR=/workspace/data/context_files
CONTEXT_CACHE_FILE=/workspace/data/context_cache.json
UPLOADED_FILES_FILE=/workspace/data/uploaded_files.json
CONTEXT_AFFINITY_FILE=/workspace/data/session_affinity.json
CONTEXT_INLINE_MAX_CHARS=4000
CONTEXT_FORCE_FILE_MAX_CHARS=10000
CONTEXT_ATTACHMENT_TTL_SECONDS=1800
# 生图默认上游模型（升级换新模型只改这里，无需改代码）
IMAGE_GENERATION_MODEL=qwen3.8-max
# 生图请求 extra.meta.model（留空=不发送该键，模型由上面的 chat 级 model 决定）。
# t2i 真正出图的模型（messages[].extra.meta.model）。留空则不发该键，
# 出图模型交由 chat 级 IMAGE_GENERATION_MODEL 路由，不可控，故给了默认值。
IMAGE_GENERATION_META_MODEL=qwen-image-3.0-pro
# 生图本地缓存 TTL（秒），已弃用：生成物清理改由 GENERATED_MEDIA_TTL_SECONDS 统一控制
GENERATED_IMAGE_TTL_SECONDS=3600
# 生成物（图片/视频）保留秒数；0 = 永久保留（媒体库语义）
GENERATED_MEDIA_TTL_SECONDS=0
# 视频回源下载体积上限（字节），超限退回 CDN 直链，避免打爆内存
GENERATED_VIDEO_MAX_BYTES=268435456
# 上游 SSE 每帧的累计 usage 接入（扣费与响应展示同源）。false=完全回落到本地 tiktoken 估算
QWEN_UPSTREAM_USAGE_ENABLED=true
# 上游 input_tokens 是否已包含附件文本。默认 false=保守继续叠加 context_attachment_tokens；
# 实测确认上游已计入附件后置 true，避免 prompt_tokens 重复计费
QWEN_UPSTREAM_USAGE_INCLUDES_ATTACHMENT_TOKENS=false
# 上游 SSE 首帧/空闲超时（秒）。上游风控（AWSC）软拦会以 200 + 裸 JSON 返回
# （形如 {"success":false,"data":{"code":"Bad_Request","details":"Internal error..."}}），
# 代码会立即判错、不重试、不再干等；本项只兜「真·静默断流」，故默认 20 秒。
QWEN_UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=20
CONTEXT_UPLOAD_PARSE_TIMEOUT_SECONDS=60
# ---- 多模态附件（图片 / 音频 / 视频）----
# 默认 true：图片/音频/视频走 data URI 内联（实测上游 files[i].url 直接接受 data URI；
# /api/v2/files/getstsToken 现已被阿里云 WAF 拼图验证码拦住，默认不再走 OSS 上传）。
# 文档（pdf/docx/txt…）仍需上传 + 解析，仍走原链路。
#
# ⚠️ 内联容量很小：上游 files[i].url 是 max_length=8192 的字符串（实测 8182 通过 /
# 8198 被拒 "url too long"），data URI 前缀也算长度，因此只装得下约 6KB 二进制：
#   - 图片：会自动降采样 + 重编码（长边 768→512→…→128，质量 85→60→40）压进上限，
#     典型真实照片会压成 ~5KB / 192px 长边缩略图（场景可辨、细节丢失）；
#   - 音频：只适合 <=1.5s @32kbps 的短音频，再长会返回 400 attachment_too_large；
#   - 视频：内联基本不可行（6KB 放不下任何可用视频），请走文件上传 API。
INLINE_ATTACHMENT_ENABLED=true
# 原始字节护栏（默认 10MB），只用于防止超大 base64 打满内存；
# 真正能否内联由下面的 url 字符数决定。
INLINE_ATTACHMENT_MAX_BYTES=10485760
# 上游 files[].url 字符上限（默认 8192，与上游 max_length 一致）。
# 实现里另留 92 字符边距，实际生效阈值 8100；超过即压缩（图片）或 400（音视频）。
INLINE_ATTACHMENT_MAX_URL_CHARS=8192
# 是否允许下载远程 http(s) URL 附件。**默认 false**：开启后网关会替调用方发起出网
# 请求，存在 SSRF 风险（内网探测 / 云元数据 169.254.169.254 泄露凭证）。
# 开启时会做私网地址校验（每跳重定向都复检），但默认仍建议保持关闭。
INLINE_ATTACHMENT_REMOTE_FETCH=false
# 模态门控：true=模型不支持该模态时返回 400；false=只丢弃该附件并 warn。
MULTIMODAL_STRICT=true
# 模型模态覆盖表（JSON），用于上游新增/调整模型时免改代码。
# 例：MODEL_MODALITIES_OVERRIDE={"qwen3.8-max":["text","image","video","audio"]}
MODEL_MODALITIES_OVERRIDE=
# ---- 浏览器上传代理（过阿里云拼图验证码，换 getstsToken 的 STS）----
# 内联装不下（>~6KB）的图片/音频/视频、以及所有文档，可以改由「真实浏览器」
# 过验证码拿 STS，再由 Python 侧（oss2）PUT 到 OSS —— 这样文件大小不再受 8192 限制。
#
# 两种模式：
#   remote（UPLOAD_CDP_ENDPOINT 非空）—— 连远程 CDP 端点（browserless / 远程 Chrome）；
#   local （UPLOAD_CDP_ENDPOINT 留空）—— 在 API 进程内直接启动一个 Playwright Chromium，
#                                       不依赖外部机器（镜像里已带 playwright + chromium）。
#
# 远程 CDP 端点（browserless / 远程 Chrome 的 DevTools 端口）。留空 = 用内置浏览器。
# 例：UPLOAD_CDP_ENDPOINT=http://10.6.6.4:3000
UPLOAD_CDP_ENDPOINT=
# 连接模式：auto（默认）/ local / remote
#   auto  = endpoint 非空走 remote，为空走 local
#   local = 强制用内置 Chromium（忽略 endpoint）
#   remote= 强制用远程 CDP（endpoint 为空则整条链路关闭）
UPLOAD_BROWSER_MODE=auto
# 浏览器上传总开关。默认 never（关闭）：该通道通过率尚未验证，且失败代价是把请求
# 拖慢几十秒到几分钟（起 Chromium + 种登录态 + 解拼图）并消耗账号风控分。
# 只有「调用方真实提供的附件」会走浏览器上传；网关内部生成的 context 文件永远不走。
# auto（= always）= 允许浏览器上传（具体走 remote 还是 local 见上一项）
# never          = 完全不用浏览器上传（默认）
UPLOAD_VIA_BROWSER=never
# 一次上传最多解几轮拼图验证码（实测 1~2 轮，留 3 轮余量）；连续失败达到该轮数后
# 该账号冷却 10 分钟，避免把风控分越打越高。
UPLOAD_CAPTCHA_MAX_ROUNDS=3
# 等验证码滑块出现的超时（秒）。
UPLOAD_CAPTCHA_TIMEOUT_SECONDS=30
# 取 STS（context.request.post）的单次超时（秒）。页面内 fetch 被 baxia 劫持后会永不
# settle（AbortController 也无效），改走 APIRequestContext 后靠这个超时保证一定返回；
# 必须明显小于下面的 UPLOAD_BROWSER_HARD_TIMEOUT_SECONDS。
UPLOAD_STS_REQUEST_TIMEOUT_SECONDS=15
# 鼠标位移 ↔ 拼图位移映射：auto（默认，优先读标定缓存，无缓存则自动两点标定）/
# linear（1:1）/ quadratic（内置实测常数 a=0.003555 b=0.075899）。
UPLOAD_DRAG_MAPPING=auto
# 单次浏览器上传（连接 + 验证码 + 取 STS）的总超时（秒）。
UPLOAD_BROWSER_TIMEOUT_SECONDS=120
# 浏览器上传路径的独立硬超时（秒，默认 45）：整段「读字节 + 换 STS + OSS PUT」都受它
# 约束，超时按「浏览器不可用」处理并降级（HTTP 上传 / 内联），同时熔断该账号 10 分钟。
UPLOAD_BROWSER_HARD_TIMEOUT_SECONDS=45
# 拖动比例标定缓存文件（auto 模式读写；缓存里记录了标定时的 mode，模式变了会重标）。
UPLOAD_DRAG_CALIBRATION_FILE=data/drag_calibration.json
DOCKER_DNS_1=223.5.5.5
DOCKER_DNS_2=119.29.29.29
