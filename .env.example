ADMIN_KEY=change-me-now
PORT=7860
WORKERS=1
LOG_LEVEL=INFO
MAX_INFLIGHT=1
MAX_RETRIES=3
ACCOUNT_MIN_INTERVAL_MS=1200
REQUEST_JITTER_MIN_MS=120
REQUEST_JITTER_MAX_MS=360
RATE_LIMIT_BASE_COOLDOWN=600
RATE_LIMIT_MAX_COOLDOWN=3600
# WAF 命中后固定账号原地重试前的额外冷却（秒），避免连续撞击加重风控
WAF_RETRY_EXTRA_COOLDOWN_SECONDS=5
# Qwen 网页协议版本（按最新官网抓包，可按部署环境覆盖）
QWEN_WEB_VERSION=0.3.10
QWEN_BX_VERSION=2.5.37
# qwen-max / qwen-plus 的上游目标；升级模型时只改这里
QWEN_MAX_MODEL=qwen3.8-max
QWEN_PLUS_MODEL=qwen3.7-plus
# 未设置时预热自动跟随上面两个别名；显式设为空可关闭默认模型预热
# CHAT_ID_PREWARM_MODELS=
# 上游出站代理（留空=直连）。对接 MicroWARP（Cloudflare WARP SOCKS5）示例：
# UPSTREAM_PROXY=socks5h://microwarp:1080
# 带认证：socks5h://user:pass@microwarp:1080
# 会注入 curl_cffi new_session（chat/login/预热/WAF 首页 GET）和 httpx 重试路径。
UPSTREAM_PROXY=
# 默认 false=主流式走 curl_cffi（TLS 指纹 + 代理）。true=回退 httpx Go-like（易被 WAF 打）。
# QWEN_CHAT_TRANSPORT_GO_LIKE_HTTP=false
ACCOUNTS_FILE=/workspace/data/accounts.json
USERS_FILE=/workspace/data/users.json
CAPTURES_FILE=/workspace/data/captures.json
CONTEXT_GENERATED_DIR=/workspace/data/context_files
CONTEXT_CACHE_FILE=/workspace/data/context_cache.json
UPLOADED_FILES_FILE=/workspace/data/uploaded_files.json
CONTEXT_AFFINITY_FILE=/workspace/data/session_affinity.json
CONTEXT_INLINE_MAX_CHARS=4000
CONTEXT_FORCE_FILE_MAX_CHARS=10000
CONTEXT_ATTACHMENT_TTL_SECONDS=1800
# 生图默认上游模型（升级换新模型只改这里，无需改代码）
IMAGE_GENERATION_MODEL=qwen3.8-max
# 生图请求 extra.meta.model（留空=不发送该键，模型由上面的 chat 级 model 决定）。
# 仅当上游要求 t2i 单独指定出图模型时才填，例如 qwen-image-3.0-pro
IMAGE_GENERATION_META_MODEL=
# 生图本地缓存 TTL（秒），到期自动清理，防磁盘撑爆
GENERATED_IMAGE_TTL_SECONDS=3600
# 上游 SSE 每帧的累计 usage 接入（扣费与响应展示同源）。false=完全回落到本地 tiktoken 估算
QWEN_UPSTREAM_USAGE_ENABLED=true
# 上游 input_tokens 是否已包含附件文本。默认 false=保守继续叠加 context_attachment_tokens；
# 实测确认上游已计入附件后置 true，避免 prompt_tokens 重复计费
QWEN_UPSTREAM_USAGE_INCLUDES_ATTACHMENT_TOKENS=false
CONTEXT_UPLOAD_PARSE_TIMEOUT_SECONDS=60
DOCKER_DNS_1=223.5.5.5
DOCKER_DNS_2=119.29.29.29
